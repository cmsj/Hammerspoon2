{% extends "base.njk" %}

{% block breadcrumb %}
<nav class="breadcrumb" aria-label="Breadcrumb">
    <span class="breadcrumb-current">API Reference</span>
</nav>
{% endblock %}

{% block content %}
<div class="page-header">
    <h1 style="font-family: var(--font-sans); font-size: 1.875rem;">Hammerspoon 2 API Documentation</h1>
    <span class="page-badge">Reference</span>
</div>

<p style="color: var(--text-secondary); font-size: 0.9375rem; margin-bottom: 1.5rem; line-height: 1.65;">
    Welcome to the Hammerspoon 2 API reference. Browse modules for top-level functionality, or explore types for object APIs.
</p>

<div class="grid" style="margin-bottom: 2rem;">
    <a href="getting-started.html" class="card">
        <h3>New to Hammerspoon 2?</h3>
        <p>Start with the Getting Started guide — hotkeys, object lifecycle, watchers, and hs.ui.</p>
    </a>
    <a href="spoons-guide.html" class="card">
        <h3>Installing or writing a Spoon?</h3>
        <p>Learn how to install and use Spoons, and how to write your own with a worked example.</p>
    </a>
    <a href="migration-guide.html" class="card">
        <h3>Coming from Hammerspoon 1?</h3>
        <p>Read the migration guide for what moved, what changed, and what was removed.</p>
    </a>
</div>

<h2 class="section-heading">Modules</h2>
<p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.75rem;">
    Modules are the main entry points for Hammerspoon functionality, accessible via the <code>hs</code> global.
</p>
<div class="grid">
    {% for module in modules %}
    <a href="{{ module.name }}.html" class="card">
        <h3>{{ module.name }}</h3>
        <p>{{ module.swiftProtocols }} protocols · {{ module.javascriptFunctions }} functions</p>
    </a>
    {% endfor %}
</div>

<h2 class="section-heading">Types</h2>
<p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.75rem;">
    Types represent objects that can be created and manipulated in Hammerspoon scripts.
</p>
<div class="grid">
    {% for type in types %}
    <a href="{{ type }}.html" class="card">
        <h3>{{ type }}</h3>
    </a>
    {% endfor %}
</div>
{% endblock %}
