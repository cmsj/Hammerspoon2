#!/bin/bash
#
# hs2vm — run Hammerspoon 2 tests and builds inside headless Tart macOS VMs, so they
# don't take over the host's screen, keyboard and mouse.
#
# Usage: scripts/vm/hs2vm <command> [args]
#
#   provision            Build the golden image (hs2-golden) from the Cirrus Labs base image
#   test [--keep] [xcodebuild args...]
#                        Build for testing on the host, run the tests in a throwaway clone of
#                        hs2-golden, and collect results into build/vm/runs/<timestamp>/.
#                        e.g. test "-only-testing:Hammerspoon 2Tests/HSHashIntegrationTests"
#   build                Build the app and tests on the host (build-for-testing)
#   up <vm>              Clone hs2-golden as <vm> (name must start hs2-) and boot it
#   down <vm>            Stop and delete <vm>
#   install <vm> [--app <path>] [--config <init.js>]
#                        Install a build (default: the latest `build`) and launch it with
#                        hs.ipc started (for `hs`), plus the given config
#   hs <vm> [js]         Evaluate JavaScript (argument or stdin) in the guest's running app,
#                        via hs.ipc and hs2; exits 65 if it threw, 1 if the app is unreachable
#   click|doubleclick|rightclick|move <vm> <x> <y>
#   drag <vm> <x1> <y1> <x2> <y2>
#   key <vm> <chord...>  e.g. key hs2-dev cmd+space return
#   type <vm> <text>     Synthesized mouse/keyboard input; coordinates are screenshot pixels
#   start <vm>           Boot a VM headless and wait for the guest agent
#   stop <vm>            Shut a VM down
#   exec <vm> <cmd...>   Run a command in the guest (as the logged-in admin user)
#   screenshot <vm> <png>
#                        Capture the guest display
#   status               List hs2-* VMs
#
# Requires tart (https://tart.run). VM state (logs, shared folder) lives in
# build/vm/vms/<vm>/; the shared folder appears in the guest at "/Volumes/My Shared Files/run".
#
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VM_ROOT="$REPO_ROOT/build/vm"
BASE_IMAGE="${HS2VM_BASE_IMAGE:-ghcr.io/cirruslabs/macos-golden-gate-base:latest}"
GOLDEN="hs2-golden"
XCODE_APP="${HS2VM_XCODE:-$(dirname "$(dirname "$(xcode-select -p)")")}"
VM_CPUS="${HS2VM_CPUS:-6}"
VM_MEMORY_MB="${HS2VM_MEMORY_MB:-16384}"
VM_DISK_GB="${HS2VM_DISK_GB:-100}"
PRODUCTS="$VM_ROOT/DerivedData/Build/Products"
GUEST_APP="/Applications/Hammerspoon 2.app"

die() { echo "hs2vm: $*" >&2; exit 1; }
log() { echo "hs2vm: $*" >&2; }

vm_dir() { echo "$VM_ROOT/vms/$1"; }

vm_exists() { tart list --quiet 2>/dev/null | grep -qx "$1"; }

vm_running() { tart list 2>/dev/null | awk -v n="$1" '$2 == n && $NF == "running" { found = 1 } END { exit !found }'; }

# Everything that builds into or reads from the shared DerivedData (build, test, install) holds
# this lock, so concurrent hs2vm runs can't swap the products out from under each other. The lock
# is a symlink whose target is the owner's PID: creating it is atomic and records the owner in the
# same step, so there's never a lock without an owner, and one left by a dead process is reclaimed.
# (A kernel flock would be inherited by long-lived children such as Xcode's build service.)
PRODUCTS_LOCK="$VM_ROOT/products-lock"
products_locked=0

lock_products() {
    local waited=0 holder
    mkdir -p "$VM_ROOT"
    until ln -s "$$" "$PRODUCTS_LOCK" 2>/dev/null; do
        holder="$(readlink "$PRODUCTS_LOCK" 2>/dev/null || true)"
        if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
            rm -f "$PRODUCTS_LOCK"
            continue
        fi
        (( waited++ == 0 )) && log "waiting for another hs2vm to finish with the build products (pid ${holder:-?})"
        sleep 1
    done
    products_locked=1
}

unlock_products() {
    (( products_locked )) || return 0
    rm -f "$PRODUCTS_LOCK"
    products_locked=0
}

# A throwaway VM that `test` should delete on exit.
cleanup_vm=""

on_exit() {
    unlock_products
    if [[ -n "$cleanup_vm" ]]; then
        cmd_stop "$cleanup_vm" || true
        tart delete "$cleanup_vm" >/dev/null 2>&1 || true
        rm -rf "$(vm_dir "$cleanup_vm")"
    fi
}
trap on_exit EXIT

# There's deliberately no VNC: Virtualization.framework's VNC server (`tart run --vnc*`) asserts
# while setting up some client connections, killing the whole VM. Screenshots and input are done
# from inside the guest instead (screencapture, and the hs2vm-guest tool posting CGEvents).
GUEST_TOOL="/usr/local/bin/hs2vm-guest"

# start <vm> [extra tart run args...]
cmd_start() {
    local vm="$1"; shift
    vm_exists "$vm" || die "no such VM: $vm"
    vm_running "$vm" && { log "$vm already running"; return; }
    local dir; dir="$(vm_dir "$vm")"
    mkdir -p "$dir/run"
    # Run tart in its own session so the VM outlives whatever started it: process-group cleanup
    # by the calling shell or tool (e.g. an agent harness) otherwise kills it minutes later.
    nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' -- \
        tart run "$vm" --no-graphics --no-audio --no-clipboard \
        --dir="run:$dir/run" "$@" </dev/null >"$dir/tart-run.log" 2>&1 &
    local pid=$!
    disown
    # Don't call `tart list` while the VM is starting: it races Virtualization.framework's
    # startup and makes it fail with "Internal Virtualization error". Watch the PID instead.
    local start=$SECONDS
    until tart exec "$vm" true >/dev/null 2>&1; do
        kill -0 "$pid" 2>/dev/null || die "$vm exited during boot: $(tail -1 "$dir/tart-run.log")"
        (( SECONDS - start > 180 )) && die "$vm: guest agent not reachable after 180s (see $dir/tart-run.log)"
        sleep 1
    done
    # The Cirrus Labs image posts a persistent "App Background Activity" banner at every boot;
    # wait (briefly) for it and close it so it doesn't sit over windows under test.
    tart exec "$vm" "$GUEST_TOOL" dismiss-notifications 15 >/dev/null || true
    log "$vm ready after $(( SECONDS - start ))s"
}

cmd_stop() {
    local vm="$1"
    vm_running "$vm" || return 0
    tart stop "$vm" --timeout 60 >/dev/null
}

cmd_exec() {
    local vm="$1"; shift
    tart exec "$vm" "$@"
}

cmd_screenshot() {
    local vm="$1" out="$2"
    tart exec "$vm" sh -c 'f=$(mktemp -t hs2vm).png && screencapture -x "$f" && cat "$f" && rm -f "$f"' >"$out"
    [[ -s "$out" ]] || die "$vm: screenshot failed"
    echo "$out ($(sips -g pixelWidth -g pixelHeight "$out" | awk '/pixel/ { printf "%s%s", sep, $2; sep = "x" }'))"
}

# <input command> <vm> <args...>: click, doubleclick, rightclick, move, drag, key, type
cmd_input() {
    local command="$1" vm="$2"; shift 2
    tart exec "$vm" "$GUEST_TOOL" "$command" "$@"
}

# up <vm>: clone the golden image (if needed) and boot it, for interactive work.
cmd_up() {
    local vm="$1"
    [[ "$vm" == hs2-* ]] || die "VM names must start with hs2-"
    vm_exists "$vm" || { vm_exists "$GOLDEN" || die "no golden image; run: hs2vm provision"; tart clone "$GOLDEN" "$vm"; }
    cmd_start "$vm"
}

# down <vm>: stop and delete a VM created by `up`.
cmd_down() {
    local vm="$1"
    [[ "$vm" != "$GOLDEN" ]] || die "refusing to delete the golden image"
    cmd_stop "$vm"
    vm_exists "$vm" && tart delete "$vm"
    rm -rf "$(vm_dir "$vm")"
}

# install <vm> [--app <path>] [--config <init.js>]
cmd_install() {
    local vm="$1"; shift
    local app="$PRODUCTS/Debug/Hammerspoon 2.app" config=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --app) app="$2"; shift 2 ;;
            --config) config="$2"; shift 2 ;;
            *) die "usage: install <vm> [--app <path>] [--config <init.js>]" ;;
        esac
    done
    [[ "$app" == "$PRODUCTS"/* ]] && lock_products
    [[ -d "$app" ]] || host_build "$VM_ROOT/build.log"
    [[ -d "$app" ]] || die "no app at $app"

    tart exec "$vm" pkill -x "Hammerspoon 2" >/dev/null 2>&1 || true
    log "installing $(basename "$app") as $GUEST_APP"
    tar -C "$(dirname "$app")" -s ",^$(basename "$app"),Hammerspoon 2.app," -cf - "$(basename "$app")" \
        | tart exec -i "$vm" sh -c 'rm -rf "/Applications/Hammerspoon 2.app" && tar -C /Applications -xpf -'
    unlock_products

    # `hs2vm hs` talks to the app through hs.ipc and the real hs2 CLI, so IPC always leads the config.
    { echo "hs.ipc.start();"; if [[ -n "$config" ]]; then cat "$config"; fi; } \
        | tart exec -i "$vm" sh -c 'mkdir -p ~/.config/Hammerspoon2 && cat > ~/.config/Hammerspoon2/init.js'

    # Skip the first-launch Welcome window, which holds off loading the config until clicked.
    tart exec "$vm" defaults write net.tenshu.Hammerspoon-2 hasCompletedOnboarding -bool true
    tart exec "$vm" open "$GUEST_APP"
    local start=$SECONDS
    until [[ "$(cmd_hs "$vm" '1+1' 2>/dev/null)" == "2" ]]; do
        (( SECONDS - start > 60 )) && die "app didn't answer within 60s (first launch shows a Welcome window until clicked; see: hs2vm screenshot $vm out.png)"
        sleep 1
    done
    # Registering the IPC broker with SMAppService posts a "Background item added" banner.
    tart exec "$vm" "$GUEST_TOOL" dismiss-notifications 3 >/dev/null || true
    log "Hammerspoon 2 running in $vm (ready after $(( SECONDS - start ))s)"
}

# hs <vm> [js]: evaluate JavaScript (argument, or stdin) in the guest's running app through
# hs.ipc, using the app's own hs2 CLI. Exits with hs2's status: 65 if the JavaScript threw (or a
# Promise it returned rejected), 1 if hs2 couldn't reach the app.
cmd_hs() {
    local vm="$1" code json out rc=0
    if [[ $# -ge 2 ]]; then code="$2"; else code="$(cat)"; fi
    # hs2 evaluates one line at a time, so send the script as one indirect eval of a JSON string:
    # multi-line code works, runs in global scope, and yields its last value. hs2 doesn't await
    # Promises, so a Promise's outcome is parked in a shared store under a key unique to this call
    # and polled for; a rejection is rethrown by the poll so that hs2 reports it like any other
    # error. The key is deleted once read (or on timeout), so a late outcome from an abandoned or
    # concurrent call can never be picked up by another one.
    json="$(printf '%s' "$code" | python3 -c 'import json, sys; print(json.dumps(sys.stdin.read()))')"
    local key="k$$_${RANDOM}_${SECONDS}"
    local store="(globalThis.__hs2vmPending ??= Object.create(null))"
    # Unique to this call, so no value a script returns can be mistaken for it.
    local pending="__HS2VM_PENDING_${key}__"
    out="$(hs2_eval "$vm" "(() => { const v = (0, eval)($json); if (v && typeof v.then === 'function') { const s = $store; s.$key = null; v.then(r => { if ('$key' in s) s.$key = { value: r } }, e => { if ('$key' in s) s.$key = { error: e } }); return '$pending' } return v })()")" || rc=$?
    local start=$SECONDS
    while (( rc == 0 )) && [[ "$out" == "$pending" ]]; do
        if (( SECONDS - start > 120 )); then
            hs2_eval "$vm" "delete $store.$key" >/dev/null || true
            echo "hs2vm: Promise still pending after 120s" >&2
            return 1
        fi
        sleep 0.2
        out="$(hs2_eval "$vm" "(() => { const s = $store, p = s.$key; if (p === null) return '$pending'; delete s.$key; if (p && 'error' in p) throw p.error; return p ? p.value : undefined })()")" || rc=$?
    done
    if (( rc != 0 )); then
        printf '%s\n' "$out" >&2
        return "$rc"
    fi
    printf '%s\n' "$out"
}

# hs2_eval <vm> <one line of JS>: prints hs2's output and returns its exit status. Drops hs2's
# "Connected to Hammerspoon 2" banner (only its first line, and only if it is the banner), and
# strips colours only from failure output, since a successful value is printed verbatim.
hs2_eval() {
    local raw rc=0 first
    raw="$(printf '%s\n' "$2" | tart exec -i "$1" "$GUEST_APP/Contents/MacOS/hs2" --no-prompt 2>&1)" || rc=$?
    first="${raw%%$'\n'*}"
    if [[ "$(printf '%s' "$first" | strip_colours)" == "Connected to Hammerspoon 2" ]]; then
        if [[ "$raw" == "$first" ]]; then raw=""; else raw="${raw#*$'\n'}"; fi
    fi
    if (( rc != 0 )); then
        printf '%s' "$raw" | strip_colours
    else
        printf '%s' "$raw"
    fi
    return "$rc"
}

strip_colours() { sed -e $'s/\e\\[[0-9;]*m//g'; }

# Builds the app and test bundle on the host: it needs no UI, and keeps incremental builds
# fast. A separate DerivedData avoids fighting with the developer's own Xcode builds.
host_build() {
    local build_log="$1"
    mkdir -p "$(dirname "$build_log")"
    log "building for testing (log: $build_log)"
    if ! xcodebuild build-for-testing \
            -scheme Development -destination 'platform=macOS' \
            -derivedDataPath "$VM_ROOT/DerivedData" \
            CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO \
            >"$build_log" 2>&1; then
        grep -E 'error:|BUILD FAILED' "$build_log" | tail -20 >&2
        die "build failed (see $build_log)"
    fi
    # With signing disabled the bundle has no sealed signature, only the linker's per-binary
    # ad-hoc ones, and SMAppService then won't register the hs.ipc broker launch agent. A
    # proper ad-hoc signature is enough (Debug builds skip hs.ipc's same-team checks).
    codesign --force --deep --sign - "$PRODUCTS/Debug/Hammerspoon 2.app" >>"$build_log" 2>&1 \
        || die "ad-hoc signing failed (see $build_log)"
}

# test [--keep] [xcodebuild args...]
cmd_test() {
    local keep=0
    if [[ "${1:-}" == "--keep" ]]; then keep=1; shift; fi
    vm_exists "$GOLDEN" || die "no golden image; run: hs2vm provision"

    local id vm out rc
    # The PID keeps IDs (and so VM names and results directories) unique across simultaneous runs.
    id="$(date +%Y%m%d-%H%M%S)-$$"
    vm="hs2-run-$id"
    out="$VM_ROOT/runs/$id"
    mkdir -p "$out"
    log "results: $out"

    tart clone "$GOLDEN" "$vm"
    if (( keep )); then
        log "keeping $vm afterwards (hs2vm stop $vm; tart delete $vm)"
    else
        cleanup_vm="$vm"
    fi
    # Boot before taking the products lock, so the lock only covers build, sign and copy.
    cmd_start "$vm"

    lock_products
    host_build "$out/build.log"
    # Stream rather than use the virtiofs share: copying bundles out of a share hits ELOOP on symlinks.
    log "copying build products into the guest"
    tar -C "$PRODUCTS" -cf - . \
        | tart exec -i "$vm" sh -c 'rm -rf ~/hs2-run && mkdir -p ~/hs2-run/Products && tar -C ~/hs2-run/Products -xpf -'
    unlock_products
    cp "$REPO_ROOT/scripts/vm/guest/run-tests.sh" "$(vm_dir "$vm")/run/"

    log "running tests (log: $out/xcodebuild.log)"
    set +e
    tart exec "$vm" bash "/Volumes/My Shared Files/run/run-tests.sh" "$@" >"$out/xcodebuild.log" 2>&1
    rc=$?
    set -e

    log "collecting results"
    cmd_screenshot "$vm" "$out/final.png" >/dev/null 2>&1 || true
    tart exec "$vm" sh -c 'cd ~/hs2-run && tar -cf - TestResults.xcresult 2>/dev/null' | tar -C "$out" -xf - || true
    tart exec "$vm" sh -c 'mkdir -p /tmp/crash-reports
        find ~/Library/Logs/DiagnosticReports /Library/Logs/DiagnosticReports -name "Hammerspoon 2*.ips" \
            -exec cp {} /tmp/crash-reports/ \; 2>/dev/null
        tar -C /tmp -cf - crash-reports' | tar -C "$out" -xf - || true
    if [[ -d "$out/TestResults.xcresult" ]] && command -v node >/dev/null; then
        node "$REPO_ROOT/scripts/xcresult-report.js" "$out/TestResults.xcresult" >"$out/summary.md" 2>/dev/null || true
    fi

    grep -E '^(\*\* TEST|Test run with|✘ Test run)' "$out/xcodebuild.log" | tail -3 >&2 || true
    local crashes; crashes="$(ls "$out/crash-reports" 2>/dev/null | wc -l | tr -d ' ')"
    (( crashes > 0 )) && log "$crashes crash report(s) in $out/crash-reports"
    log "exit $rc; results in $out"
    return "$rc"
}

cmd_status() {
    tart list | awk 'NR == 1 || $2 ~ /^hs2-/'
}

cmd_provision() {
    local work="$GOLDEN-provisioning"
    [[ -d "$XCODE_APP" ]] || die "Xcode not found at $XCODE_APP"
    log "base image: $BASE_IMAGE"
    log "Xcode: $XCODE_APP ($(xcodebuild -version | tr '\n' ' '))"

    cmd_stop "$work"
    vm_exists "$work" && tart delete "$work"
    tart clone "$BASE_IMAGE" "$work"
    tart set "$work" --cpu "$VM_CPUS" --memory "$VM_MEMORY_MB" --disk-size "$VM_DISK_GB"

    local dir; dir="$(vm_dir "$work")"
    rm -rf "$dir"; mkdir -p "$dir/run"
    cp "$REPO_ROOT/scripts/vm/guest/provision.sh" "$dir/run/"
    cmd_start "$work"

    log "installing $GUEST_TOOL"
    swiftc -O "$REPO_ROOT/scripts/vm/guest/hs2vm-guest.swift" -o "$VM_ROOT/hs2vm-guest"
    tart exec -i "$work" sudo sh -c "mkdir -p /usr/local/bin && cat > $GUEST_TOOL && chmod 755 $GUEST_TOOL" \
        <"$VM_ROOT/hs2vm-guest"

    log "copying $(basename "$XCODE_APP") into the guest as /Applications/Xcode.app"
    tar -C "$(dirname "$XCODE_APP")" -s ",^$(basename "$XCODE_APP"),Xcode.app," -cf - "$(basename "$XCODE_APP")" \
        | tart exec -i "$work" sudo tar -C /Applications -xpf -
    tart exec "$work" bash "/Volumes/My Shared Files/run/provision.sh" 2>&1 | tee "$dir/provision.log"
    cmd_screenshot "$work" "$dir/provisioned.png" >/dev/null || true
    cmd_stop "$work"

    cmd_stop "$GOLDEN"
    vm_exists "$GOLDEN" && tart delete "$GOLDEN"
    tart rename "$work" "$GOLDEN"
    rm -rf "$(vm_dir "$GOLDEN")"; mv "$dir" "$(vm_dir "$GOLDEN")"
    log "golden image ready: $GOLDEN"
}

[[ $# -ge 1 ]] || { awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"; exit 1; }
command="$1"; shift
case "$command" in
    provision)  cmd_provision "$@" ;;
    start)      [[ $# -ge 1 ]] || die "usage: start <vm>"; cmd_start "$@" ;;
    stop)       [[ $# -eq 1 ]] || die "usage: stop <vm>"; cmd_stop "$1" ;;
    exec)       [[ $# -ge 2 ]] || die "usage: exec <vm> <cmd...>"; cmd_exec "$@" ;;
    screenshot) [[ $# -eq 2 ]] || die "usage: screenshot <vm> <out.png>"; cmd_screenshot "$@" ;;
    test)       cmd_test "$@" ;;
    build)      lock_products; host_build "$VM_ROOT/build.log" ;;
    up)         [[ $# -eq 1 ]] || die "usage: up <vm>"; cmd_up "$1" ;;
    down)       [[ $# -eq 1 ]] || die "usage: down <vm>"; cmd_down "$1" ;;
    install)    [[ $# -ge 1 ]] || die "usage: install <vm> [--app <path>] [--config <init.js>]"; cmd_install "$@" ;;
    hs)         [[ $# -ge 1 ]] || die "usage: hs <vm> [js]"; cmd_hs "$@" ;;
    click|doubleclick|rightclick|move|drag|key|type)
                [[ $# -ge 2 ]] || die "usage: $command <vm> <args...>"; cmd_input "$command" "$@" ;;
    status)     cmd_status ;;
    *)          die "unknown command: $command" ;;
esac
